datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum JobStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  OUT_OF_SERVICE
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  PAID
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Tenant {
  id              String           @id @default(uuid())
  name            String
  status          TenantStatus     @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  users           User[]
  roles           Role[]
  customers       Customer[]
  jobs            Job[]
  vehicles        Vehicle[]
  drivers         Driver[]
  employees       Employee[]
  payrollRuns     PayrollRun[]
  gpsPings        GPSPing[]
  reportSnapshots ReportSnapshot[]
  auditLogs       AuditLog[]

  @@index([status])
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  roleId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  role   Role?  @relation(fields: [roleId], references: [id])

  @@index([tenantId])
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  users  User[]

  @@unique([tenantId, name])
}

model Customer {
  id           String         @id @default(uuid())
  tenantId     String
  name         String
  status       String
  billingEmail String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  contacts     Contact[]
  quotes       Quote[]
  tickets      ServiceTicket[]
  jobs         Job[]

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Contact {
  id         String   @id @default(uuid())
  customerId String
  name       String
  email      String?
  phone      String?
  role       String?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
}

model Quote {
  id         String   @id @default(uuid())
  customerId String
  status     String
  amount     Decimal  @db.Decimal(12, 2)
  currency   String   @default("USD")
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
}

model ServiceTicket {
  id          String         @id @default(uuid())
  customerId  String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  subject     String
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
}

model Job {
  id          String    @id @default(uuid())
  tenantId    String
  customerId  String
  status      JobStatus @default(PENDING)
  scheduledAt DateTime?
  origin      String
  destination String
  driverId    String?
  vehicleId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  driver   Driver?  @relation(fields: [driverId], references: [id])
  vehicle  Vehicle? @relation(fields: [vehicleId], references: [id])

  @@index([tenantId])
  @@index([status])
}

model Vehicle {
  id            String        @id @default(uuid())
  tenantId      String
  vin           String        @unique
  plateNumber   String
  status        VehicleStatus @default(ACTIVE)
  make          String?
  model         String?
  year          Int?
  lastServiceAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  maintenance   MaintenanceRecord[]
  fuelLogs      FuelLog[]
  gpsPings      GPSPing[]
  jobs          Job[]

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([status])
}

model Driver {
  id            String       @id @default(uuid())
  tenantId      String
  employeeId    String?
  firstName     String
  lastName      String
  licenseNumber String
  status        DriverStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  jobs          Job[]
  gpsPings      GPSPing[]

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
}

model MaintenanceRecord {
  id          String   @id @default(uuid())
  vehicleId   String
  serviceDate DateTime
  description String?
  cost        Decimal  @db.Decimal(12, 2)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
}

model FuelLog {
  id        String   @id @default(uuid())
  vehicleId String
  loggedAt  DateTime @default(now())
  gallons   Decimal  @db.Decimal(10, 2)
  cost      Decimal  @db.Decimal(12, 2)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
}

model Employee {
  id        String   @id @default(uuid())
  tenantId  String
  firstName String
  lastName  String
  roleTitle String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  timeLogs  TimeEntry[]

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model TimeEntry {
  id         String   @id @default(uuid())
  employeeId String
  clockIn    DateTime
  clockOut   DateTime?

  employee Employee @relation(fields: [employeeId], references: [id])
}

model PayrollRun {
  id          String        @id @default(uuid())
  tenantId    String
  periodStart DateTime
  periodEnd   DateTime
  status      PayrollStatus @default(DRAFT)
  createdAt   DateTime      @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model GPSPing {
  id         String   @id @default(uuid())
  tenantId   String
  vehicleId  String
  driverId   String?
  latitude   Decimal  @db.Decimal(9, 6)
  longitude  Decimal  @db.Decimal(9, 6)
  speedMph   Decimal? @db.Decimal(6, 2)
  recordedAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  driver  Driver? @relation(fields: [driverId], references: [id])

  @@index([tenantId])
  @@index([recordedAt])
}

model ReportSnapshot {
  id          String   @id @default(uuid())
  tenantId    String
  type        String
  generatedAt DateTime @default(now())
  payload     Json

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  actor  User?  @relation(fields: [actorId], references: [id])

  @@index([tenantId])
  @@index([createdAt])
}
